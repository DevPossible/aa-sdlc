{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aasdlc.com/schemas/aa.config.schema.json",
  "title": "aa.config.yaml",
  "description": "The AA-SDLC configuration file, one per scope, merged enterprise, team, user, project. See docs/formats.md section 2.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "scope"],
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "scope": { "type": "string", "enum": ["enterprise", "team", "user", "project"] },
    "targets": { "type": "array", "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }, "uniqueItems": true },
    "plugins": { "type": "array", "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }, "uniqueItems": true },
    "plugins_exclude": { "type": "array", "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }, "uniqueItems": true },
    "conventions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ticket": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "project": { "type": "string", "minLength": 1, "description": "The one ticket system project or group this repository maps to (O-09)." },
            "url": { "type": "string", "format": "uri" },
            "pattern": { "type": "string", "minLength": 1, "description": "Regular expression for a ticket id (R-08)." },
            "tag": { "type": "string", "minLength": 1 }
          }
        },
        "knowledge": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "space": { "type": "string", "minLength": 1, "description": "The knowledge repository for this project (O-04)." },
            "url": { "type": "string", "format": "uri" }
          }
        },
        "branch": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "pattern": { "type": "string", "minLength": 1 } }
        },
        "commit": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "pattern": { "type": "string", "minLength": 1, "description": "Conventional Commits (O-14)." },
            "types": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[a-z]+$" }, "uniqueItems": true },
            "scopes": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
          }
        }
      }
    },
    "folders": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "documents": { "type": "string", "minLength": 1 },
        "features": { "type": "string", "minLength": 1 },
        "scripts": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "tests": { "type": "string", "minLength": 1 },
        "decisions": { "type": "string", "minLength": 1, "description": "Decision record location (O-18); a folder or a knowledge base page." }
      }
    },
    "organisation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": { "type": "string", "minLength": 1, "description": "The organisation config repository: enterprise scope at its root." },
        "team": { "type": "string", "minLength": 1, "description": "Subfolder of the organisation repository holding the team scope." }
      }
    },
    "install": {
      "type": "object",
      "additionalProperties": false,
      "description": "Written by aa setup at user scope: what was installed and when.",
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "updated": { "type": "string", "minLength": 1 }
      }
    }
  }
}
