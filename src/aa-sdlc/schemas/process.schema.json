{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aasdlc.com/schemas/process.schema.json",
  "title": "AA-SDLC process",
  "description": "One process: src/aa-sdlc/workflow/processes/<id>.yaml. Steps are order, not enforcement (T-03). See docs/formats.md section 1.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "summary", "steps"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "name": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "methodology": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase"],
      "properties": { "phase": { "type": "integer", "minimum": 1 } }
    },
    "steps": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" } },
    "guidance_sets": { "type": "array", "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }, "uniqueItems": true },
    "guidance": { "type": "array", "items": { "type": "string", "pattern": "^G-([0-9]{2}|[a-z][a-z0-9-]*-[0-9]{2})$" }, "uniqueItems": true },
    "exit": { "type": "string", "minLength": 1 }
  }
}
