{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aasdlc.com/schemas/discipline.schema.json",
  "title": "AA-SDLC discipline",
  "description": "One discipline: src/aa-sdlc/workflow/disciplines/<id>.yaml. See docs/formats.md section 1.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "code", "name", "order", "purpose", "owns", "does_not_own", "steps"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "code": { "type": "string", "pattern": "^[a-z]{2,3}$" },
    "name": { "type": "string", "minLength": 1 },
    "order": { "type": "integer", "minimum": 0 },
    "purpose": { "type": "string", "minLength": 1 },
    "owns": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "does_not_own": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "hands_off_to": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["discipline", "when"],
        "properties": {
          "discipline": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "when": { "type": "string", "minLength": 1 }
        }
      }
    },
    "steps": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }, "uniqueItems": true },
    "tenets": { "type": "array", "items": { "type": "string", "pattern": "^T-[0-9]{2}$" }, "uniqueItems": true },
    "opinions": { "type": "array", "items": { "type": "string", "pattern": "^O-[0-9]{2}$" }, "uniqueItems": true }
  }
}
